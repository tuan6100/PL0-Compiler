PROGRAM HeapSort;

PROCEDURE swap(VAR x, VAR y);
    VAR t;
    BEGIN
        t := x;
        x := y;
        y := t;
    END;

PROCEDURE heapify(VAR arr[], size, nodeIdx);
    VAR largest, leftChild, rightChild, temp;
    BEGIN
        largest := nodeIdx;
        leftChild := 2 * nodeIdx + 1;
        rightChild := 2 * nodeIdx + 2;
        IF (leftChild < size) AND (arr[leftChild] > arr[largest]) THEN
            largest := leftChild;
        IF (rightChild < size) AND (arr[rightChild] > arr[largest]) THEN
            largest := rightChild;
        IF largest <> nodeIdx THEN
            BEGIN
                CALL swap(arr[nodeIdx], arr[largest]);
                CALL heapify(arr, size, largest);
            END;
    END;

PROCEDURE sort(VAR arr[], size);
    VAR i, temp;
    BEGIN
        FOR i := (size >> 1) DOWNTO 0 DO
            CALL heapify(arr, size, i);
        FOR i := size - 1 DOWNTO 1  DO
            BEGIN
                swap(arr[0], arr[i]);
                CALL heapify(arr, i, 0);
            END;
    END;

VAR arr[5] := [2, 4, 3, 5, 1], i;
CONST n = SIZEOF(arr);
BEGIN
    CALL sort(arr, n);
    FOR i := 0 TO n - 1 DO
        BEGIN
            CALL WRITE("${arr[i]}");
            IF i < n - 1 THEN CALL WRITE(", ");
        END;
END.

