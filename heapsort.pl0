PROGRAM HeapSort;

PROCEDURE heapify(VAR arr[], size, nodeIdx);
    VAR largest, leftChild, rightChild, temp;
    BEGIN
        largest := nodeIdx;
        leftChild := 2 * nodeIdx + 1;
        rightChild := 2 * nodeIdx + 2;

        IF (leftChild < size) AND (arr[leftChild] > arr[largest]) THEN
            largest := leftChild;
        IF (rightChild < size) AND (arr[rightChild] > arr[largest]) THEN
            largest := rightChild;

        IF largest <> nodeIdx THEN
            BEGIN
                temp := arr[nodeIdx];
                arr[nodeIdx] := arr[largest];
                arr[largest] := temp;
                CALL heapify(arr, size, largest);
            END;
    END;

PROCEDURE sort(VAR arr[], size);
    VAR i, temp;
    BEGIN
        FOR i := (size >> 1) DOWNTO 0 STEP 1 DO
            CALL heapify(arr, size, i);

        FOR i := size - 1 DOWNTO 1 STEP 1 DO
            BEGIN
                temp := arr[0];
                arr[0] := arr[i];
                arr[i] := temp;
                CALL heapify(arr, i, 0);
            END;
    END;

VAR arr[8] := [12, 11, 13, 5, 6, 7, 2, 1], i;
CONST n = SIZEOF(arr);
BEGIN
    CALL sort(arr, n);
    FOR i := 0 TO n - 1 STEP 1 DO
        CALL WRITELN("${arr[i]}");
END.

