PROGRAM Circle;
CONST PI = 3.1416;

FUNCTION calculateArea(radius);
    BEGIN
        RETURN PI * radius * radius;
    END;

PROCEDURE printArea(radius);
    BEGIN
         WRITELN("The area of a circle with a radius of $radius is: ${calculateArea(radius)}");
    END;

VAR r;
BEGIN
    WRITELN(PI);
    r := 2;
    printArea(r);
    r := 3.5;
    printArea(r);
END
