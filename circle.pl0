PROGRAM Circle;
CONST PI = 3.1416;

PROCEDURE calculateArea(radius);
    BEGIN
        RETURN PI * radius * radius
    END;

PROCEDURE printArea(radius);
    BEGIN
         CALL WRITELN("The area of a circle with a radius of $radius is: ${calculateArea(radius)}")
    END;

VAR r;
BEGIN
    CALL WRITELN(PI);
    r := 2;
    CALL printArea(r);
    r := 3.5;
    CALL printArea(r);
END
