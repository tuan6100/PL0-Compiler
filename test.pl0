PROGRAM TEST;
CONST LIMIT = 10;
VAR i, x, arr[LIMIT];

PROCEDURE SHOW(value);
BEGIN
    WRITE("$value ");
END;

BEGIN
    x := 0;
    arr[1] := x + LIMIT;
    READ(x);

    IF ODD x THEN
        x := x + 1;
    ELSE
        x := x - 1;

    WHILE x < 10 DO
        x := x + 1;

    FOR i := 0 TO LIMIT - 1DO
    BEGIN
        arr[i] := i % 2;
        SHOW(arr[i]);
    END
END.
