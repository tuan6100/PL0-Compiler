PROGRAM Matrix;

CONST mat[3][3] = [[1, 2, 3],
                   [4, 5, 6],
                   [7, 8, 9]];
CONST rows = SIZEOF(mat) / SIZEOF(mat[0]),
      cols = SIZEOF(mat[0]);

VAR i, j;

BEGIN
    WRITELN(mat);
    FOR i := 0 TO rows - 1 DO
    BEGIN
        FOR j := 0 TO cols - 1 DO
        BEGIN
            WRITE("${mat[i][j]} ");
        END;
        WRITELN();
    END;
END.
