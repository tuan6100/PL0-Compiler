PROGRAM Matrix;

CONST MAT[3][3] = [[1, 2, 3],
                   [4, 5, 6],
                   [7, 8, 9]];

VAR i, j;

BEGIN
    FOR i := 0 TO 2 DO
    BEGIN
        FOR j := 0 TO SIZEOF(MAT[0]) - 1 DO
        BEGIN
            CALL WRITE(MAT[i][j]);
            CALL WRITE(" ");
        END;
        CALL WRITELN();
    END;
END.
