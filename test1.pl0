PROGRAM TEST;
CONST LIMIT = 3;
VAR i, x, arr[5];

PROCEDURE SHOW(var value);
BEGIN
    CALL WRITE(value);
END;

BEGIN
    x := 0;
    arr[1] := x + LIMIT;
    CALL READ(x);

    IF ODD x THEN
        x := x + 1;
    ELSE
        x := x - 1;

    WHILE x < 10 DO
        x := x + 1;

    FOR i := 1 TO LIMIT DO
    BEGIN
        arr[i] := i % 2;
        CALL SHOW(arr[i]);
    END
END.
